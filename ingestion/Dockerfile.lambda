FROM public.ecr.aws/lambda/python:3.11

WORKDIR /var/task

COPY pyproject.toml ./
COPY src/ ./src/

# NumPy 2.4+ often lacks manylinux wheels here; preinstall a wheel build.
RUN pip install --upgrade pip && \
    pip install "numpy==2.2.6" "tiktoken" --only-binary :all: && \
    pip install --no-cache-dir .

CMD ["ingestion.handler.handler"]
