# AWS
AWS_REGION=us-east-1
CLUSTER_NAME=kube-rag-langg

# LangSmith Cloud (free tier works — no self-hosted license needed)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-showcase

# LLM — Bedrock only for this demo
BEDROCK_REGION=us-east-1
DEFAULT_LLM_MODEL=us.anthropic.claude-sonnet-4-6
DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_PROVIDER=bedrock

# Web search for research agents (https://tavily.com)
TAVILY_API_KEY=

# Demo lifecycle (see docs/DEMO_COSTS.md)
DEMO_MODE=true
DEPLOYMENT_TIER=cloud
ENABLE_MONITORING=false

# RAG (filled automatically after terraform apply)
S3_DOCUMENT_BUCKET=
QDRANT_URL=http://qdrant.rag.svc.cluster.local:6333
QDRANT_COLLECTION=research_docs

# Research tuning (keep low for demo cost control)
MAX_RESEARCHER_PARALLEL=2
RAG_TOP_K=6
RAG_MIN_VECTOR_SCORE=0.12
RAG_EXPAND_SAME_DOCUMENT=true
RAG_SAME_DOCUMENT_MAX_PER_DOC=12
RAG_FILTER_NON_BODY_HITS=true
RAG_COMPARE_SYMMETRIC_BASELINE=true
CRAG_ENABLED=true
CRAG_GRADER_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0
CRAG_LEXICAL_RESCUE=true
SWAG_ENABLED=true
# Profile source: heuristic (free, tests/demo) or llm (Bedrock Sonnet/Haiku)
SWAG_PROFILE_MODE=heuristic
SWAG_INGEST_PROFILES=true
SWAG_MIN_SCORE_THRESHOLD=0.08
SWAG_MAX_CHUNKS_PER_SOURCE=2
SWAG_DEDUPLICATE_SIMILARITY=0.92
SWAG_ADAPTIVE_BLEND=true
SWAG_GRADER_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0
SWAG_RETRIEVAL_CANDIDATES=20
SWAG_VECTOR_WEIGHT=0.65
SWAG_WEIGHT=0.30
SWAG_METADATA_WEIGHT=0.05
SWAG_MAX_TERMS_PER_LIST=12
SWAG_MAX_WEIGHTED_TERMS=24
SWAG_MAX_TERM_CHARS=80
SWAG_UNGROUNDED_TERM_WEIGHT_MULTIPLIER=0.35
SWAG_FUZZY_MIN_TOKEN_LEN=4
