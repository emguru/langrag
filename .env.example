# AWS
AWS_REGION=us-east-1

# LangSmith Cloud (free tier)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-demo
LANGSMITH_TRACING=true

# Bedrock
BEDROCK_REGION=us-east-1
DEFAULT_LLM_MODEL=us.amazon.nova-lite-v1:0
DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_PROVIDER=bedrock

# RAG core
S3_DOCUMENT_BUCKET=local-documents
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_docs

# Tuning
RAG_TOP_K=5
RAG_MIN_VECTOR_SCORE=0.12
RAG_MIN_VECTOR_SCORE_TOPIC=0.08
RAG_MIN_VECTOR_SCORE_PROSE=0.12
RAG_MIN_VECTOR_SCORE_MARKDOWN=0.10
RAG_MIN_VECTOR_SCORE_CODE=0.08
RAG_MIN_VECTOR_SCORE_TABLE=0.10
RAG_HYBRID=true
RAG_RERANK=true
RERANK_MODEL_ID=amazon.rerank-v1:0
RERANK_REGION=us-west-2
RAG_CORRECTIVE=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Agents (local docker compose)
INGESTION_API_URL=http://ingestion:8001

# Lambda / AWS deploy
USE_DYNAMODB_CHECKPOINTER=false
CHECKPOINT_TABLE=langrag-clean-checkpoints

# Legacy EKS (only if -c cleanRag=false)
CLUSTER_NAME=kube-rag-langg
