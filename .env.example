# AWS
AWS_REGION=us-east-1
CLUSTER_NAME=kube-rag-langg

# LangSmith Cloud (free tier works — no self-hosted license needed)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-showcase

# LLM — Bedrock only for this demo
BEDROCK_REGION=us-east-1
DEFAULT_LLM_MODEL=us.anthropic.claude-sonnet-4-6
DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_PROVIDER=bedrock

# Web search for research agents (https://tavily.com)
TAVILY_API_KEY=

# Demo lifecycle (see docs/DEMO_COSTS.md)
DEMO_MODE=true
DEPLOYMENT_TIER=cloud
ENABLE_MONITORING=false

# RAG (filled automatically after terraform apply)
S3_DOCUMENT_BUCKET=
QDRANT_URL=http://qdrant.rag.svc.cluster.local:6333
QDRANT_COLLECTION=research_docs

# Research tuning (keep low for demo cost control)
MAX_RESEARCHER_PARALLEL=2
RAG_TOP_K=6
CRAG_ENABLED=true
