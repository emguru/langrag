{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "clusterName": "kube-rag-langg",
    "adminPrincipalArn": "arn:aws:iam::280793168415:user/aiad-admin",
    "cognitoDomainPrefix": "kube-rag-langg-demo",
    "appDomainName": "langrag.automatico.llc",
    "certificateArn": "",
    "budgetAlertEmail": "michael@automatico.llc",
    "bedrockBudgetUsd": 50,
    "defaultLlmModel": "us.anthropic.claude-sonnet-4-6",
    "defaultEmbeddingModel": "amazon.titan-embed-text-v2:0",
    "cragGraderModel": "us.anthropic.claude-3-5-haiku-20241022-v1:0",
    "demoMode": true,
    "enableRds": false,
    "enableElastiCache": false,
    "nodeInstanceType": "t3.large",
    "nodeMinSize": 0,
    "nodeMaxSize": 2,
    "nodeDesiredSize": 1,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true
  }
}
